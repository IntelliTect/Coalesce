{
  "name": "coalesce-vue-docs",
  "version": "0.1.0-local",
  "description": "In-app product documentation for Coalesce applications, rendered from markdown by VitePress's markdown renderer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntelliTect/Coalesce.git"
  },
  "author": "IntelliTect",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./vuetify": {
      "types": "./dist/vuetify/index.d.ts",
      "default": "./dist/vuetify/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "README.md",
    "client.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --noEmit && vue-tsc -p ./tsconfig.build-types.json && tsc -p ./tsconfig.build-vite.json",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^8.2.0",
    "vitepress": "2.0.0-alpha.19",
    "vue": "^3.5.40",
    "vue-router": "^4.4.1 || ^5.0.0",
    "vuetify": "^3.7.1 || ^4.0.0"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.19",
    "vue": "^3.5.40",
    "vue-router": "^4.4.1 || ^5.0.0",
    "vuetify": "4.0.5"
  }
}
